# Copie para .env (que está no .gitignore). SOMENTE testnet, carteiras novas, nunca com dinheiro real.

# Carteiras de teste (chaves privadas: SEGREDO)
OWNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
JOURNALIST_PRIVATE_KEY=

# Endereços (públicos)
OWNER_ADDRESS=
RELAYER_ADDRESS=
JOURNALIST_ADDRESS=

# Arkiv (Rabdi): chave de acesso do Hub (SEGREDO)
ARKIV_ACCESS_KEY=

# World ID (Developer Portal): rp_id e app_id são identificadores; a chave de assinatura é SEGREDO
WORLD_APP_ID=
WORLD_RP_ID=
RP_SIGNING_KEY=
WORLD_ENVIRONMENT=staging

# Rede (RPC público comum; configurável)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network

# Regras do MVP
EPOCH_PERIOD=monthly
