# Copy to .env (which is in .gitignore). TESTNET ONLY, new wallets, never with real money.

# Test wallets (private keys: SECRET)
OWNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
JOURNALIST_PRIVATE_KEY=

# Addresses (public)
OWNER_ADDRESS=
RELAYER_ADDRESS=
JOURNALIST_ADDRESS=

# Arkiv (Rabdi): Hub access key (SECRET)
ARKIV_ACCESS_KEY=

# World ID (Developer Portal): rp_id and app_id are identifiers; the signing key is SECRET
WORLD_APP_ID=
WORLD_RP_ID=
RP_SIGNING_KEY=
WORLD_ENVIRONMENT=staging

# Network (common public RPC; configurable)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network

# MVP rules
EPOCH_PERIOD=monthly
